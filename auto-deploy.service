[Unit]
Description=DISABLED legacy Google Drive auto-deploy helper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sridhar
WorkingDirectory=/home/sridhar/Desktop/trading_robot
ExecStart=/home/sridhar/Desktop/trading_robot/.venv/bin/python3 /home/sridhar/Desktop/trading_robot/auto_deploy_watcher.py
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

# Deliberately no [Install] section: manual deployment only.
