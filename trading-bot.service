[Unit]
Description=NIFTY Algo Trading Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sridhar
WorkingDirectory=/home/sridhar/Projcts/trading_robot
Environment=PATH=/home/sridhar/Projcts/trading_robot/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/sridhar/Projcts/trading_robot/.venv/bin/python3 /home/sridhar/Projcts/trading_robot/main_autonomous.py
# CRITICAL: Restart=always so SIGTERM (clean exit) also triggers restart
# Without this, every /deploy permanently kills the bot
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
