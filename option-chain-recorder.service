[Unit]
Description=Option Chain Snapshot Recorder — NIFTY/BANKNIFTY/FINNIFTY
After=network-online.target trading-bot.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sridhar
WorkingDirectory=/home/sridhar/Projcts/trading_robot
ExecStart=/home/sridhar/Projcts/trading_robot/.venv/bin/python3 /home/sridhar/Projcts/trading_robot/option_chain_recorder.py --loop --interval-sec 300 --underlyings NIFTY,BANKNIFTY,FINNIFTY
Restart=always
RestartSec=30
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
