[Unit]
Description=Trade Guardian Bot — Manual Trade Manager
After=network-online.target
Wants=network-online.target
# Start after main bot if present
After=trading-bot.service

[Service]
Type=simple
User=owner
WorkingDirectory=/home/owner/Desktop/trading_robot
EnvironmentFile=/home/owner/Desktop/trading_robot/.env
ExecStart=/home/owner/Desktop/trading_robot/.venv/bin/python3 /home/owner/Desktop/trading_robot/trade_guardian_bot.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trade-guardian

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
