[Unit]
Description=Manual Trade Tracker — AI Analysis for your trades
After=network-online.target trading-bot.service
# Wants= so systemd actually waits for network-online.target before start.
# Without it, After= alone does not pull the target into the boot transaction,
# so the tracker could start before the network was up (2026-06-05 04:27 reboot)
# and its Angel login failed. Pairs with the in-process reconnect fallback.
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sridhar
WorkingDirectory=/home/sridhar/Projcts/trading_robot
ExecStart=/home/sridhar/Projcts/trading_robot/.venv/bin/python3 /home/sridhar/Projcts/trading_robot/manual_trade_tracker.py
Restart=always
RestartSec=30
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1
Environment=MANUAL_AUTO_PROTECT=true
Environment=MANUAL_POLL_INTERVAL_SEC=30
Environment=MANUAL_UPDATE_INTERVAL_SEC=900

[Install]
WantedBy=multi-user.target
