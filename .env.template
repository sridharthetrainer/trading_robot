# ═══════════════════════════════════════════════════════════════
# TRADING ROBOT — PRODUCTION .env
# Updated: May 2026 — All keys from Sridhar's configuration
# ═══════════════════════════════════════════════════════════════

# ── Angel One Broker ───────────────────────────────────────────
API_KEY=your_api_key_here
CLIENT_ID=your_client_id_here
PASSWORD=your_password_here
TOTP_SECRET=your_totp_secret_here

# ── Telegram ────────────────────────────────────────────────────
# ⚠️  TOKEN IS REVOKED — Get new token from @BotFather:
#    /mybots → select bot → API Token → copy token
#    Then run: ./update_token.sh <new_token>
# OR: Replace the line below and run ./bot.sh restart
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_FREE_CHANNEL_ID=your_telegram_free_channel_id_here
TELEGRAM_PREMIUM_CHANNEL_ID=your_telegram_premium_channel_id_here
TELEGRAM_ENABLED=true
BOT_NAME=NIFTY Algo Bot

# ── External Data APIs ─────────────────────────────────────────
NEWS_API_KEY=your_news_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_CONSUMER_KEY=your_twitter_consumer_key_here
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
FRED_API_KEY=your_fred_api_key_here
TWELVE_DATA_KEY=your_twelve_data_key_here
TIINGO_KEY=your_tiingo_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── Fyers (disabled — daily OAuth not autonomous) ──────────────
FYERS_TOKEN=your_fyers_token_here

# ── Cloud Backup ───────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=sridharthetrainer/trading_robot
GDRIVE_REMOTE=gdrive
GDRIVE_FOLDER=trading_robot
BACKUP_GDRIVE_FOLDER=TradingRobotBackup

# ── Trading Mode ───────────────────────────────────────────────
PAPER_TRADING=false
ENABLE_REAL_TRADING=true
AUTO_MODE_SWITCH=true
MIN_LIVE_CAPITAL=500

# ── Capital ────────────────────────────────────────────────────
CAPITAL=9871
PAPER_CAPITAL=100000
REAL_CAPITAL=your_real_capital_here

# ── Risk Limits ────────────────────────────────────────────────
MAX_DAILY_LOSS=3000
SOFT_DAILY_LOSS_LIMIT=2000
WEEKLY_LOSS_LIMIT=9000
MAX_CONSECUTIVE_LOSSES=3
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=15
MAX_LOTS=2
RISK_PER_TRADE_PCT=0.01
DRAWDOWN_TRIGGER_PCT=0.15
PROFIT_LOCK_PCT=0.30

# ── Signal Quality ─────────────────────────────────────────────
VIX_MAX_FOR_BUYING=22.0
MIN_CONFLUENCE_SCORE=5.5
POST_CONFLUENCE_MIN_SCORE=5.5
MIN_BARS_FOR_SIGNAL=20
MIN_VOLUME_RATIO_ENTRY=0.40
MIN_BREAKOUT_VOLUME_RATIO=1.20
AI_FILTER_THRESHOLD=2.0

# ── Capital Allocation ─────────────────────────────────────────
SWING_CAPITAL_PCT=0.45
INTRADAY_CAPITAL_PCT=0.30
SCALPING_CAPITAL_PCT=0.15
RESERVE_CAPITAL_PCT=0.10
SWING_MODE_ENABLED=true
SWING_MIN_SCORE=5.0
SWING_MIN_CONFIDENCE=0.75
SWING_MIN_DTE=5

# ── Options Settings ───────────────────────────────────────────
OPTION_LOT_SIZE=75
OPTION_STOP_0DTE=0.10
OPTION_STOP_1DTE=0.15
OPTION_STOP_2DTE=0.18
OPTION_STOP_MULT=0.20

# ── Execution ──────────────────────────────────────────────────
PREFER_LIMIT_FOR_OPTIONS=true
ENABLE_1M_ENTRY_TIMING=true
SCAN_INTERVAL_SEC=300

# ── Overnight Protection ───────────────────────────────────────
OVERNIGHT_UNCERTAINTY_THRESHOLD=0.65
OVERNIGHT_GAP_ALERT_PCT=0.005
OVERNIGHT_GAP_CLOSE_PCT=0.010
OVERNIGHT_NEWS_SCAN=true

# ── Market Timing ──────────────────────────────────────────────
MARKET_START=09:15
MARKET_END=15:30
TIMEZONE=Asia/Kolkata
TOKEN_REFRESH_TIMES=08:00,20:00

# ── System ─────────────────────────────────────────────────────
LOG_FILE=trading_bot.log
LOG_LEVEL=INFO
TRADES_DB=trades.db
DB_PATH=trades.db
ENABLE_WALK_FORWARD=true

# ── Dhan API (FREE backup — permanent token) ───────────────────
# Get from: dhan.co → Profile → API Access
DHAN_CLIENT_CODE=
DHAN_TOKEN_ID=

# ── Zerodha Kite (₹2000/mo — activate when capital > ₹2L) ─────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_PIN=
ZERODHA_TOKEN_DATE=

# Upstox (free — get Analytics Token from upstox.com/developer)
UPSTOX_ANALYTICS_TOKEN=
