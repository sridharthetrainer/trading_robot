  "levels": {
    "pivot_set": "traditional",
    "pivot_formulas": "P=(H+L+C)/3; R1=2P-L; S1=2P-H; R2=P+(H-L); S2=P-(H-L); R3=2P+(H-2L); S3=2P-(2H-L); R4=3P+(H-3L); S4=3P-(3H-L)",
    "cpr_formulas": "P=(H+L+C)/3; BC=(H+L)/2; TC=2P-BC; BC/TC swapped when BC>TC",
    "camarilla_formulas": "H3=C+1.1(H-L)/4; H4=C+1.1(H-L)/2; H5=(H/L)*C; L3=C-1.1(H-L)/4; L4=C-1.1(H-L)/2; L5=C-(H5-C)",
    "period_source": "daily=prior session, weekly=prior calendar week (Mon-Sun), monthly=prior calendar month; all from spot 09:15-15:29 1m bars"
  },
  "cpr_width_pct": {"narrow_below": 0.15, "wide_above": 0.35},

